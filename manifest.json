{
  "manifest_version": 3,
  "name": "Oscure UTP - Modo Oscuro para UTP+class & SSO",
  "version": "1.0.0",
  "description": "Modo oscuro elegante, fluido y de alto contraste para UTP+class, SSO UTP y portales de la Universidad Tecnológica del Perú.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Oscure UTP"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.utp.edu.pe/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.utp.edu.pe/*"
      ],
      "css": [
        "content/dark-core.css",
        "content/sso-dark.css",
        "content/class-dark.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Alternar el modo oscuro ON/OFF"
    }
  }
}
